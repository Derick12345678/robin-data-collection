# Local Robin configuration; copy with: python scripts/robin.py prepare
# Startup and offline verification need no provider key.
# Add only the approved model provider key when needed; never commit robin.env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Robin defaults aligned with the approved scope where upstream supports them.
# These are defaults, not scope enforcement. The live adapter must enforce the
# batch/byte/time/retry limits and conditional page collection in queries.json.
ROBIN_DEFAULT_THREADS=2
ROBIN_DEFAULT_MAX_RESULTS=20
ROBIN_DEFAULT_MAX_SCRAPE=10
ROBIN_DEFAULT_CONTENT_CHARS=10000
# Optional local model endpoint; no model is installed by this project.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# ROBIN_MODEL=
